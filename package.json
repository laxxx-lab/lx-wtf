{
  "name": "hermes-voice-desktop",
  "version": "0.2.0-preview.1",
  "private": true,
  "description": "Hermes Voice desktop client for your own Hermes gateway",
  "homepage": "https://github.com/laxxx-lab/lx-wtf",
  "main": "desktop-entry.cjs",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File ./launch.ps1",
    "test": "node --test tests/*.test.cjs",
    "start:desktop": "electron .",
    "package:prepare": "node scripts/prepare-package.cjs",
    "dist": "npm run package:prepare && electron-builder",
    "runtime:install": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "ws": "8.22.0"
  },
  "author": "Hermes Voice contributors",
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.15.3"
  }
}
